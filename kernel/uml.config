# Tier 1 kernel configuration: User-Mode Linux, x86_64, Linux 7.0.
# scripts/build-uml.sh merges this over arch/um x86_64_defconfig and fails if
# any CONFIG_ line below does not appear verbatim in the resulting .config.
CONFIG_UML_TIME_TRAVEL_SUPPORT=y
# CONFIG_SMP is not set
CONFIG_STATIC_LINK=y
CONFIG_HOSTFS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_NET_NS=y
CONFIG_VETH=y
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_NETEM=y
CONFIG_NET_SCH_FQ=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_CUBIC=y
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# Reproducible runs: no host entropy, all randomness from um_seed= (our
# arch/um patch "um: add CONFIG_UML_SEEDED_RANDOM").
# CONFIG_UML_RANDOM is not set
# CONFIG_HW_RANDOM is not set
CONFIG_UML_SEEDED_RANDOM=y
